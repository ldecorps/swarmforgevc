{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.bl1911.stryker.config.mjs",
    "related": false
  },
  "mutate": [
    "out/tools/localSeatRepoRead.js",
    "out/tools/localQwenSeatLive.js"
  ],
  "incremental": false,
  "concurrency": 8,
  "timeoutMS": 60000,
  "timeoutFactor": 3,
  "coverageAnalysis": "perTest",
  "appendPlugins": ["./out/mutation/stryker-plugin.js"],
  "ignorers": ["entrypoint-boilerplate"],
  "reporters": ["clear-text", "progress", "json"],
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "dryRunTimeoutMinutes": 15
}
