{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.letsTalkCore.config.mjs",
    "related": false
  },
  "concurrency": 1,
  "timeoutMS": 60000,
  "timeoutFactor": 3,
  "incremental": false,
  "coverageAnalysis": "perTest",
  "appendPlugins": ["./out/mutation/stryker-plugin.js"],
  "ignorers": ["entrypoint-boilerplate"],
  "reporters": ["clear-text", "progress"],
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "mutate": ["out/bridge/letsTalkCore.js"]
}
