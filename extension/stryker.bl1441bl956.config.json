{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.bl1441bl956.stryker.config.mjs",
    "related": false
  },
  "concurrency": 1,
  "timeoutMS": 60000,
  "timeoutFactor": 3,
  "incremental": false,
  "coverageAnalysis": "perTest",
  "appendPlugins": [
    "./out/mutation/stryker-plugin.js"
  ],
  "ignorers": [
    "entrypoint-boilerplate"
  ],
  "reporters": [
    "clear-text",
    "progress",
    "mutation-progress",
    "json"
  ],
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "mutate": [
    "out/concierge/pipelineBoard.js"
  ]
}