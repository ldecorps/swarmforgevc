{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.bl1468.stryker.config.mjs",
    "related": false
  },
  "concurrency": 4,
  "timeoutMS": 60000,
  "timeoutFactor": 3,
  "incremental": false,
  "coverageAnalysis": "perTest",
  "appendPlugins": ["./out/mutation/stryker-plugin.js"],
  "ignorers": ["entrypoint-boilerplate"],
  "reporters": ["clear-text", "progress", "mutation-progress"],
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "mutate": [
    "out/tools/backlogTicketId.js",
    "out/tools/bounceArgsCore.js",
    "out/tools/qa-sibling-check.js"
  ]
}
