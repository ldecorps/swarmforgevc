# Copy to <repo>/.swarmforge/operator/named-tunnel.env (gitignored) after
# setup_bubble_named_tunnel.sh succeeds. launch_resident_spy_tunnel.sh reads it.
#
# SWARMFORGE_NAMED_TUNNEL=swarmforge-bubble
# SWARMFORGE_NAMED_TUNNEL_HOSTNAME=bubble.musicalsifu.com
# Optional: absolute path to cloudflared config (default ~/.cloudflared/config.yml)
# SWARMFORGE_CLOUDFLARED_CONFIG=/Users/YOU/.cloudflared/config.yml

SWARMFORGE_NAMED_TUNNEL=swarmforge-bubble
SWARMFORGE_NAMED_TUNNEL_HOSTNAME=bubble.musicalsifu.com
