#!/usr/bin/env bash
# BL-901: shared commit-msg hook, installed repo-wide via the same
# `core.hooksPath swarmforge/git-hooks` setting the pre-commit hook uses
# (BL-105) - git resolves every hook name from that one directory, so no
# separate install step is needed for this file.
#
# git guarantees commit-msg runs, with the now-finalized message, for the
# same commit attempt whenever pre-commit passed - see the note in
# swarmforge/git-hooks/pre-commit for why the message-naming check can only
# be enforced here, not there.
#
# BL-1242: check_merge_deletion.sh is commit-msg-only for the same reason -
# it only fires on a merge (MERGE_HEAD present) and needs the finalized
# message to apply its ticket-naming exemption. No longer a single `exec`:
# both guards must run every time, so a real failure from either is never
# masked by the other's exit code. That requires NOT using `set -e` across
# the two calls: under it, a failing first call would abort the script
# before the second ever ran, hiding a real check_merge_deletion.sh
# violation behind check_ticket_deletion.sh's - the exact first-failure-
# stop shape Article 4.4 exists to forbid, and a role fixing only the
# reported violation would be blindsided by the other on its next attempt.
# Each call's own body still runs under its own `set -euo pipefail`.
set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

status=0
"$REPO_ROOT/swarmforge/scripts/check_ticket_deletion.sh" "$1" || status=$?
"$REPO_ROOT/swarmforge/scripts/check_merge_deletion.sh" "$1" || status=$?

exit "$status"
