#!/usr/bin/env bash
# BL-901: shared commit-msg hook, installed repo-wide via the same
# `core.hooksPath swarmforge/git-hooks` setting the pre-commit hook uses
# (BL-105) - git resolves every hook name from that one directory, so no
# separate install step is needed for this file.
#
# git guarantees commit-msg runs, with the now-finalized message, for the
# same commit attempt whenever pre-commit passed - see the note in
# swarmforge/git-hooks/pre-commit for why the message-naming check can only
# be enforced here, not there.
#
# BL-1242: check_merge_deletion.sh is commit-msg-only for the same reason -
# it only fires on a merge (MERGE_HEAD present) and needs the finalized
# message to apply its ticket-naming exemption. BL-1258:
# check_retirement_readdition.sh is its addition-side sibling, same
# posture.
#
# BL-1471 KNOWN RESIDUAL: the "commit-msg always runs when pre-commit
# passed" guarantee above holds for an ordinary commit and for a merge -
# it does NOT hold for `git revert` (measured against this repo's own git:
# a clean, non-conflicting `git revert -m 1 <merge>` fires neither
# pre-commit nor commit-msg, only prepare-commit-msg and post-commit).
# check_bounce_revert_scope.sh below still catches a CONFLICTED revert
# finished with a plain `git commit` (that path is an ordinary commit and
# fires normally), but a clean merge-revert's own auto-commit is
# unreachable by any guard wired here in this git version - flagged to the
# specifier as a spec-gap alongside BL-1471's own evidence, not something
# that ticket's scope extended to fixing.
#
# No longer a single `exec`: every guard must run every time, so
# a real failure from any one is never masked by another's exit code. That
# requires NOT using `set -e` across the calls: under it, a failing
# earlier call would abort the script before a later one ever ran, hiding
# a real violation behind an earlier one's - the exact first-failure-stop
# shape Article 4.4 exists to forbid, and a role fixing only the reported
# violation would be blindsided by another on its next attempt. Each
# call's own body still runs under its own `set -euo pipefail`.
set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

status=0
"$REPO_ROOT/swarmforge/scripts/check_ticket_deletion.sh" "$1" || status=$?
"$REPO_ROOT/swarmforge/scripts/check_merge_deletion.sh" "$1" || status=$?
"$REPO_ROOT/swarmforge/scripts/check_retirement_readdition.sh" "$1" || status=$?
# BL-1471: a revert commit is judged only here - see
# check_bounce_revert_scope.sh's own header for why pre-commit's call
# (run_commit_guards.sh) always defers.
"$REPO_ROOT/swarmforge/scripts/check_bounce_revert_scope.sh" "$1" || status=$?

exit "$status"
