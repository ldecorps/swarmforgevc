#!/usr/bin/env bash
# BL-105: shared pre-commit hook, installed repo-wide via
# `git config core.hooksPath swarmforge/git-hooks` (set once by
# swarmforge.sh at launch - see ensure_commit_size_guard). Every role
# worktree shares this same physical .git dir, so one install covers all
# of them. Delegates to check_commit_size.sh, check_ticket_deletion.sh and
# (BL-632) check_pipeline_code_on_main.sh so each guard's logic stays
# testable as a standalone script.
#
# BL-901: check_ticket_deletion.sh runs here with no message-file argument,
# so its enforcing half (a naked deletion unnamed in the commit message)
# always defers rather than refuses - the message does not exist yet at
# pre-commit time (githooks(5)). The commit-msg hook below re-invokes it
# with the now-known message to finish the check.
#
# BL-632: check_pipeline_code_on_main.sh also covers `git commit --amend`
# on main, since amend is a plain commit and this hook fires for it too.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

"$REPO_ROOT/swarmforge/scripts/check_commit_size.sh" 50
"$REPO_ROOT/swarmforge/scripts/check_ticket_deletion.sh"
"$REPO_ROOT/swarmforge/scripts/check_pipeline_code_on_main.sh"
