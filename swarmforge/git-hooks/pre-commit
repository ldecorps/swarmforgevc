#!/usr/bin/env bash
# BL-105: shared pre-commit hook, installed repo-wide via
# `git config core.hooksPath swarmforge/git-hooks` (set once by
# swarmforge.sh at launch - see ensure_commit_size_guard). Every role
# worktree shares this same physical .git dir, so one install covers all
# of them. Delegates to check_commit_size.sh, check_ticket_deletion.sh,
# (BL-632) check_pipeline_code_on_main.sh and (BL-570)
# check_property_suite_drift.sh so each guard's logic stays testable as a
# standalone script.
#
# BL-901: check_ticket_deletion.sh runs here with no message-file argument,
# so its enforcing half (a naked deletion unnamed in the commit message)
# always defers rather than refuses - the message does not exist yet at
# pre-commit time (githooks(5)). The commit-msg hook below re-invokes it
# with the now-known message to finish the check.
#
# BL-632: check_pipeline_code_on_main.sh also covers `git commit --amend`
# on main, since amend is a plain commit and this hook fires for it too.
# BL-1252: the four guards are no longer four sequential commands here.
# Under `set -euo pipefail` the first one that refused aborted the hook, so
# a commit violating several guards was reported one violation per attempt -
# the first-failure-stop shape Article 4.4 forbids of a reviewing role.
# run_commit_guards.sh runs them all and emits ONE refusal listing every
# violation; it also owns the cheap/expensive tiering, so an already-refused
# commit never pays for `npm run test:properties`. This hook stays a thin
# wrapper over it, the way it was always a thin wrapper over the guards.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

exec "$REPO_ROOT/swarmforge/scripts/run_commit_guards.sh" "$REPO_ROOT"
