{
  "task.allowAutomaticTasks": "on",
  "git.autofetch": true,
  "git.autofetchPeriod": 180,
  "git.pullBeforeCheckout": true,
  "git.openRepositoryInParentFolders": "never",
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.worktrees/**": true,
    "**/.swarmforge/**": true,
    "**/node_modules/**": true,
    "**/extension/out/**": true,
    "**/android/.gradle/**": true,
    "**/android/build/**": true
  },
  "search.exclude": {
    "**/.worktrees": true,
    "**/.swarmforge": true,
    "**/node_modules": true,
    "**/extension/out": true
  }
}
