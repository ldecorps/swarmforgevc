{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: compile - extension",
      "type": "npm",
      "script": "compile",
      "path": "extension",
      "problemMatcher": "$tsc",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "npm: watch - extension",
      "type": "npm",
      "script": "watch",
      "path": "extension",
      "problemMatcher": "$tsc-watch",
      "isBackground": true,
      "presentation": {
        "reveal": "never"
      },
      "group": "build"
    },
    {
      "label": "Auto git pull (loop)",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/scripts/auto-pull-loop.sh",
      "runOptions": {
        "runOn": "folderOpen"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "panel": "dedicated"
      }
    }
  ]
}
