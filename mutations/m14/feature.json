      "action" : "proceed"
    }, {
      "ahead" : "3",
      "behind" : "0",
      "deadlock" : "active",
      "action" : "proceed"
    }, {
      "ahead" : "-5",
      "behind" : "2",
      "deadlock" : "clear",
      "action" : "ff-only"
    }, {
      "ahead" : "3",
      "behind" : "1",
      "deadlock" : "clear",
      "action" : "wait-reconcile"
