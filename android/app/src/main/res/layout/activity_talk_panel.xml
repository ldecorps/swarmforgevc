<?xml version="1.0" encoding="utf-8"?>
<!-- BL-829: the pager shell — Talk (talk_panel_page.xml) is always the
     pager's first page; remote pages the resolved bundle names (remote_page.xml)
     follow it. The bare notice is the pure-logic "screens are unavailable"
     statement (PagerListResolver.PagerList.bareReason) surfaced without ever
     hiding or replacing the native Talk page beneath it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/pagerBareNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sf_panel"
        android:padding="10dp"
        android:textColor="@color/sf_muted"
        android:textSize="12sp"
        android:visibility="gone" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
