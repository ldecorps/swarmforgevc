<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="sf_bg">#FF0D1117</color>
    <color name="sf_panel">#FF161B22</color>
    <color name="sf_accent">#FF238636</color>
    <color name="sf_text">#FFE6EDF3</color>
    <color name="sf_muted">#FF8B949E</color>
    <color name="sf_bubble">#FF238636</color>
    <!-- BL-845: passive wake listening. Deliberately NOT red - red is
         reserved for a hot mic to the model (human constraint). -->
    <color name="sf_bubble_passive">#FF2A9D8F</color>
    <color name="sf_bubble_recording">#FFDA3633</color>
    <color name="sf_bubble_thinking">#FFD29922</color>
    <color name="sf_bubble_speaking">#FF1F6FEB</color>
    <!-- BL-845: unreferenced from code since red became a single derived
         colour (WakeSpotter.colourFor), which resolves both Error and
         ActiveListen to sf_bubble_recording - the same #DA3633 this always
         was. Kept because the human's colour table names an error colour. -->
    <color name="sf_bubble_error">#FFDA3633</color>
    <color name="sf_bubble_paused">#FF6E7681</color>
    <style name="Theme.FloatCompanion" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/sf_accent</item>
        <item name="android:statusBarColor">@color/sf_bg</item>
        <item name="android:navigationBarColor">@color/sf_bg</item>
        <item name="android:windowBackground">@color/sf_bg</item>
        <item name="android:textColor">@color/sf_text</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
    <!-- Real Activity for typing — overlay EditText crashes on many phones.
         windowCloseOnTouchOutside MUST stay false: the same finger-up that
         expands from the overlay is otherwise delivered as an outside tap
         and immediately finishes the panel (looks like a frozen bubble). -->
    <style name="Theme.FloatCompanion.Panel" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="colorPrimary">@color/sf_accent</item>
        <item name="android:windowBackground">@drawable/bg_panel</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <item name="android:windowMinWidthMajor">94%</item>
        <item name="android:windowMinWidthMinor">94%</item>
        <item name="android:windowSoftInputMode">adjustPan</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>
