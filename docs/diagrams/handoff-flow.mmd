%% Handoff MECHANISM (activity): how one parcel physically travels between
%% roles. swarm-flow.mmd covers WHO hands to WHOM; this covers HOW - the
%% file lifecycle new/ -> in_process/ -> completed/, the validation and
%% branch-claim gates that can refuse a claim, and the daemon sweeps that
%% wake a role which is not looking at its own mailbox.
%% BL-1697 (2026-09-24): a coder-role seat whose provider carries the
%% parcel-driver capability (aider today) is a DRIVER SEAT. handoffd's own
%% new-mail wake, chase poke and in-process-resume injections all skip a
%% driver seat - it is driven instead, once per daemon cycle, by
%% local_parcel_driver_lib.bb's drive-tick! (serve via `seat next`, merge,
%% a red acceptance check, a read-only chat set + one typed instruction,
%% then a gate on the model's turn: a commit exists, acceptance now
%% passes, the spec files are byte-identical, and every touched path was
%% in the editable set). A gate pass runs `seat handoff` + `seat done`
%% (the ordinary FORWARD/DONE path, below); a gate fail with fix turns
%% left types one fix request and re-gates; a gate fail at the limit (or
%% a merge conflict, or acceptance already green before any edit) runs
%% `seat ask` and holds the parcel `in_process`, escalated. See the
%% driver-seat subgraph below.
flowchart TD
  START(["sender role finishes work\nand commits"])
  DRAFT["writes a handoff draft\n(field: value headers, not JSON)"]
  ROOTGUARD{"draft-root-guard!:\ndraft path lies under the\nresolved project root?"}
  OUTSIDEROOT(["HANDOFF_DRAFT_OUTSIDE_ROOT:\nrefused before any write,\nnames draft path + resolved root"])
  VALIDATE{"swarm_handoff.bb validates:\ntype / to / priority present,\ncommit resolves to exactly\nONE commit object"}
  REJECT(["rejected: nothing is written,\nsender fixes the draft"])
  RECIPIENTGUARD{"git-handoff-recipient-guard-lib:\ntype: git_handoff naming\ncoordinator - draft header\nor post-routing set (BL-1565)?"}
  COORDREFUSED(["refused before any write,\nbefore AUDIT_REQUIRED: names\nthe close shape - type: note /\n'QA-approved <task> landed\n<sha> - bookkeep to done'"])
  WRITE["writes NN_<ts>_<seq>_from_X_to_Y.handoff\ninto recipient inbox/new/\n(NN = priority prefix, 00 = highest)"]
  SENT["copy retained in sender sent/"]
  DEPTH["prints active-backlog-depth\nWARNING if over cap"]

  DAEMON["handoffd sweeps:\nreplicates into each role's own\n.worktrees/<role> mailbox"]
  DRIVERSEAT{"recipient is a driver seat?\n(coder/coder@2 on a\nparcel-driver-capable agent -\nBL-1697)"}
  DRIVERSKIP(["wake/chase/resume injection\nskipped - the driver's own\ndrive-tick! owns this pane\n(invariant 2)"])
  DEFERCHECK{"note carries\nwake: defer?\n(BL-1494)"}
  CHASE{"recipient idle\nwith pending mail?"}
  WAKESESSION{"resolve-wake-session:\nconfigured session live?\n(mono-router remap applies\nonly inside a rotation-router\npack - BL-931/BL-1719)"}
  WAKE["chase sweep wakes it\n(mono-router: rotate resident\ninto that role - respawn)"]
  WAKENOSESSION(["nil session: EVERY tmux -t call\nsite (wake, in-process-resume,\ncontext-clear injectors, babysitter\nnudge) refuses before reaching\ntmux, logs the missing session\nname - never types into an\nunrelated live pane (BL-1719)"])
  WAIT(["stays queued in new/\nuntil the role next looks"])
  DEFERRED(["delivery/chase/nudge skip:\ndeliver-notify-skip-deferred -\nread only on the role's own\nnext ready_for_next.sh"])

  READY["recipient runs ready_for_next.sh"]
  PICK{"any dequeueable\nfile in new/ ?"}
  NOTASK(["NO_TASK\n(mono-router non-home role:\nROTATE_HOME instead)"])
  CLAIM["move new/ -> in_process/\nstamp dequeued_at +\nreceived_at_head (BL-1610),\nwrite .claim-progress.json"]

  GUARD{"branch-claim guard:\nworktree branch matches\nthe claimed ticket?"}
  AUTOFIX["clean but wrong branch:\nauto-checkout the standard branch,\nturn proceeds"]
  REQUEUE["dirty or uncorrectable:\nrequeue-and-refuse -\nfile moves BACK to new/"]

  WORK["agent executes the task\nand commits"]
  FORWARD["sends the next git_handoff\n(10-char commit hex)"]
  FWDGATE{"forward-gate! (BL-1609):\na forwarding git_handoff, held by a\ncode-worktree role, with no git_handoff\n(or, QA stage only - BL-1642 - no note\nnaming the ticket) sent since the inbound's\nevidence window start (BL-1645: created_at,\nelse enqueued_at, else dequeued_at)?"}
  NOTSENT(["FORWARD_NOT_SENT: refused,\nnothing moved - send the forward,\nor done_with_current.sh --no-op \"<reason>\""])
  DONE["done_with_current.sh:\nin_process/ -> completed/\n(BL-652: any argv fails fast,\nzero side effects)"]
  STALE(["skipping this leaves a stale claim\nthat re-shows on the next wake"])

  START --> DRAFT --> ROOTGUARD
  ROOTGUARD -->|outside root| OUTSIDEROOT
  ROOTGUARD -->|inside root| VALIDATE
  VALIDATE -->|invalid| REJECT
  VALIDATE -->|valid, type: git_handoff| RECIPIENTGUARD
  VALIDATE -->|valid, type: note/\nrule_proposal/awake| WRITE
  RECIPIENTGUARD -->|names coordinator| COORDREFUSED
  RECIPIENTGUARD -->|other recipient| WRITE
  WRITE --> SENT
  WRITE --> DEPTH
  WRITE --> DAEMON
  DAEMON --> DRIVERSEAT
  DRIVERSEAT -->|yes| DRIVERSKIP
  DRIVERSEAT -->|no| DEFERCHECK
  DEFERCHECK -->|yes| DEFERRED
  DEFERCHECK -->|no| CHASE
  CHASE -->|yes| WAKESESSION
  WAKESESSION -->|session exists,\nor a rotation-router pack| WAKE
  WAKESESSION -->|no session,\nnot a rotation-router pack| WAKENOSESSION
  CHASE -->|no - busy mid-turn| WAIT
  WAKE --> READY
  WAKENOSESSION --> WAIT
  WAIT --> READY
  DEFERRED --> READY
  READY --> PICK
  PICK -->|none| NOTASK
  PICK -->|lowest priority prefix wins| CLAIM
  CLAIM --> GUARD
  GUARD -->|pass| WORK
  GUARD -->|clean, wrong branch| AUTOFIX
  AUTOFIX --> WORK
  GUARD -->|dirty| REQUEUE
  REQUEUE --> WAIT
  WORK --> FORWARD
  WORK -.->|role tries to complete\nwithout forwarding first| FWDGATE
  FORWARD --> DONE
  FORWARD -.->|already forwarded,\ngate passes| FWDGATE
  FWDGATE -->|refuse: forwarding inbound,\nno forward sent, no --no-op| NOTSENT
  FWDGATE -->|complete: forward (or QA note)\nsent since window start,\n--no-op reason given, non-forwarding\ninbound, or master-resident role| DONE
  NOTSENT -.->|in_process untouched -\nsend the forward, then retry| WORK
  DONE -.->|omitted| STALE
  FORWARD -.->|recipient repeats\nthis whole cycle| START

  subgraph DRIVER["Driver seat per-tick loop (BL-1697, replaces\nREADY..DONE above for this seat only)"]
    DSERVE["drive-tick!: `seat next` claims\nthe in_process parcel,\n`seat merge <sender> <commit>`"]
    DMERGECONFLICT(["exit 3 (or nonzero):\n`seat ask` \"merge conflict\",\nstate escalated"])
    DRED{"`seat test`\n(red check, before\nany model turn)"}
    DREDESCALATE(["passed already:\n`seat ask` \"acceptance\npassed before any edit\",\nno instruction sent"])
    DCHATSET["chat cleared; ticket YAML +\nacceptance feature /read-only'd\nAND chmod unwritable;\neditable files /add'ed;\none raw instruction typed\n(no narration suffix)"]
    DIDLE{"pane idle?"}
    DGATE{"gate: commit exists,\nacceptance now passes,\nspec bytes identical,\ntouched paths ⊆ editable set"}
    DFIXLEFT{"fix turns\nremaining?"}
    DFIXTYPE["one fix request typed,\nnaming the failed condition;\ngate again next tick"]
    DESCALATE(["fix turns exhausted:\nspec write permission restored,\n`seat ask` \"<ticket>: <condition>\",\nstate escalated (held for BL-1698)"])
    DPASS["spec write permission restored,\n`seat handoff <next-role> <ticket>`\n(next-required-stage, never literal),\n`seat done`, state cleared"]
  end

  DRIVERSKIP --> DSERVE
  DSERVE -->|merge conflict| DMERGECONFLICT
  DSERVE -->|merged clean| DRED
  DRED -->|already green| DREDESCALATE
  DRED -->|red, as expected| DCHATSET
  DCHATSET --> DIDLE
  DIDLE -->|not yet - next tick| DIDLE
  DIDLE -->|idle| DGATE
  DGATE -->|pass| DPASS
  DGATE -->|fail| DFIXLEFT
  DFIXLEFT -->|yes| DFIXTYPE
  DFIXTYPE -.->|awaits idle again| DIDLE
  DFIXLEFT -->|no| DESCALATE
  DPASS -.->|same forward/done shape\nas the ordinary path| FORWARD

  classDef gate fill:#9a6700,color:#fff,stroke:#5c4200;
  classDef bad fill:#cf222e,color:#fff,stroke:#82071e;
  classDef store fill:#57606a,color:#fff,stroke:#32383f;
  classDef act fill:#1f6feb,color:#fff,stroke:#0b3d91;
  classDef daemon fill:#8250df,color:#fff,stroke:#4c2889;
  class VALIDATE,CHASE,PICK,GUARD,DEFERCHECK,ROOTGUARD,RECIPIENTGUARD,FWDGATE,DRIVERSEAT,DRED,DIDLE,DGATE,DFIXLEFT,WAKESESSION gate;
  class REJECT,REQUEUE,STALE,OUTSIDEROOT,COORDREFUSED,NOTSENT,DMERGECONFLICT,DREDESCALATE,DESCALATE bad;
  class WRITE,SENT,CLAIM,DONE,WAIT,DEFERRED,DRIVERSKIP,WAKENOSESSION store;
  class DRAFT,READY,WORK,FORWARD,AUTOFIX,DEPTH,DSERVE,DCHATSET,DFIXTYPE,DPASS act;
  class DAEMON,WAKE daemon;
