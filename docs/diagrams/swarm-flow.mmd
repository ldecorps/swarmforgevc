%% BL-247: current swarm parcel flow (2026-07-10), matching
%% swarmforge/PIPELINE.md and swarmforge/swarmforge.conf's window lines.
%% BL-663 (2026-08-01): promotion (both auto-pick and by-name) and routing
%% invoked on its own now go through one promotion_gates chokepoint
%% (promotion_gates_lib.bb / promotion_gates_cli.bb) enforcing human_approval,
%% Article 3.2.4 expedite lane, active_backlog_max_depth, the hold marker, and
%% assignee/spec-stage routing (no silent assigned_to rewrite) — a refusal
%% names the failing gate. BL-854 (2026-08-09): orthogonality (two active
%% tickets sharing an epic:) never refuses — it is a non-blocking advisory
%% (ADVISORY|orthogonality|... on stderr, naming the overlapping active
%% ticket(s)) that leaves the real file-overlap call with the coordinator,
%% per the Concurrent Work Orthogonality workflow rule.
%% BL-900 (2026-08-16): within promotion_gates' ranking (not a gate — it
%% never refuses), a candidate's containing epic's own priority is compared
%% before the candidate's own priority: [expedited? epic-priority
%% own-priority id]. Epic priority is looked up from the most urgent
%% type:epic tracker sharing the candidate's epic: (an untracked or
%% duplicated epic falls back to the candidate's own priority — never
%% buried). The Article 3.2.4 expedite bucket still ranks strictly first;
%% queue-jump and ambulance mode are untouched (neither is a ranking input).
%% BL-957 (2026-08-20): depends_on joins the refusing gates, between
%% human_approval and depth (a ticket-property refusal beats a transient
%% global one). A dependency counts as satisfied only in backlog/done/ —
%% an ACTIVE dependency still refuses — and the gate fails closed on an
%% id it cannot resolve. The refusal names every unsatisfied id.
%% BL-626 (2026-08-25): acceptance joins the refusing gates, between
%% human_approval and depends_on. An explicit specs/features/ pointer must
%% resolve to a live .feature or an admitted draft (see BL-1340); no same-id
%% sibling glob rescue. audit-acceptance lists the exposure read-only.
%% BL-1340 (2026-09-02): a .feature.draft pointer is admitted at promotion
%% when the ticket's own required_wiring: pins a specs/pipeline/steps
%% registration (self-converting); a draft with no pin still refuses, named
%% as parked. promote_and_route_next.sh's auto-select no longer partitions
%% candidates into buildable/other ahead of promotion_gates_cli.bb select,
%% so buildability can no longer outrank Article 3.2.4 expedite order. The
%% documenter->QA edge (acceptance_contract_gate_lib.bb) is the backstop:
%% a parcel whose acceptance: still names a draft at the cited commit is
%% refused there, checked ahead of wait-bound-hit? so the finding names the
%% draft rather than reading as a transient timeout.
%% cleaner and hardender are batch-mode roles (consume all queued
%% equal-priority handoffs as one batch); every other pipeline role is
%% task-mode (one handoff at a time). The coordinator sits outside the
%% forward chain: it controls intake/promotion, and after QA approval does
%% backlog bookkeeping only (move ticket to done/, promote next paused item)
%% — it runs no git merge or push. QA is the integration point: after
%% broadcasting merge-up to every worktree role, QA itself lands the
%% approved commit on main and pushes origin (BL-247).
%% BL-588 (2026-08-26): on partial batch failure, approach 3 — clean siblings
%% re-forward unchanged on their batch commit for whole-tree re-verification;
%% defective ticket reworks from last clean ancestor on an isolated branch;
%% QA lands verified whole trees only (no cherry-pick/rebase-to-land). See
%% docs/how-to/BL-588-isolate-batch-recovery-trees.md; BL-532 deferrals are input.
%% BL-668 (2026-08-27): after QA lands on origin/main, handoffd runs
%% post-qa-branch-sweep-sweep! — fast-forwards clean/ff-able role branches in
%% roles.tsv worktrees; dirty, in_process, or divergent roles are surfaced with
%% logged skip reasons. QA merge-up notes reach surfaced roles only; clean roles
%% need no LLM merge-up turn. See docs/how-to/BL-668-post-qa-deterministic-branch-sweep.md.
flowchart LR
  ROOT["backlog/ root\n(human raw intake)"]
  COORD(("coordinator\n(master, intake/routing +\nbacklog bookkeeping only,\nnever commits code,\nno git merge/push)"))
  SPEC["specifier\n(master, task)"]
  PAUSED["backlog/paused/"]
  ACTIVE["backlog/active/"]
  DONE["backlog/done/"]

  CODER["coder\n(.worktrees/coder, task)"]
  CLEANER["cleaner\n(.worktrees/cleaner, BATCH)"]
  ARCHITECT["architect\n(.worktrees/architect, task)"]
  HARDENER["hardender\n(.worktrees/hardender, BATCH)"]
  DOCUMENTER["documenter\n(.worktrees/documenter, task)"]
  QA["QA\n(.worktrees/QA, task,\nintegration point)"]

  MAIN["main branch\n(target repo)"]

  ROOT -->|drain: spec ambiguous items,\nwrite prose+Gherkin spec| SPEC
  SPEC -->|places spec| PAUSED
  PAUSED -->|promote (promotion_gates:\nhuman_approval, acceptance,\ndepends_on, expedite lane, depth,\nhold marker refuse; epic-priority\nranks before own priority;\northogonality advises only)| COORD
  COORD -->|promotes into| ACTIVE
  COORD -->|routes first parcel| SPEC
  SPEC -->|git_handoff\npriority 00| CODER

  CODER -->|git_handoff| CLEANER
  CLEANER -->|git_handoff\n(batch of queued items)| ARCHITECT
  ARCHITECT -->|git_handoff| HARDENER
  HARDENER -->|git_handoff\n(batch)| DOCUMENTER
  DOCUMENTER -->|git_handoff| QA

  QA -->|lands approved commit,\npushes origin; handoffd runs\npost-qa-branch-sweep| MAIN
  MAIN -.->|ff clean branches| CODER
  MAIN -.->|ff clean branches| CLEANER
  MAIN -.->|ff clean branches| ARCHITECT
  MAIN -.->|ff clean branches| HARDENDER
  MAIN -.->|ff clean branches| DOCUMENTER
  QA -->|merge-up note\n(surfaced roles only)| CODER
  QA -->|merge-up note| CLEANER
  QA -->|merge-up note| ARCHITECT
  QA -->|merge-up note| HARDENDER
  QA -->|merge-up note| DOCUMENTER
  QA -->|notifies: approved commit\n+ task id| COORD

  COORD -->|moves ticket| DONE
  COORD -.->|unblocks stalls| SPEC
  COORD -.->|rechecks depth cap,\npromotes next paused item| ACTIVE

  classDef coordinator fill:#8250df,color:#fff,stroke:#4c2889;
  classDef chain fill:#1f6feb,color:#fff,stroke:#0b3d91;
  classDef batch fill:#9a6700,color:#fff,stroke:#5c4200;
  classDef backlog fill:#57606a,color:#fff,stroke:#32383f;
  classDef target fill:#2ea043,color:#fff,stroke:#116329;
  class COORD coordinator;
  class SPEC,CODER,ARCHITECT,DOCUMENTER,QA chain;
  class CLEANER,HARDENER batch;
  class ROOT,PAUSED,ACTIVE,DONE backlog;
  class MAIN target;
