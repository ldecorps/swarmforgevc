%% BL-146: SwarmForge VC architecture as built (2026-07-07).
%% Two layers: the VS Code extension host (view/control) and the tmux
%% substrate (the actual SwarmForge agent processes). The extension never
%% spawns agent processes directly; it shells out to tmux/git and reads
%% .swarmforge/ state files. See swarmforge/constitution/articles/
%% local-engineering.prompt Architecture Rule 1 and swarmDiscovery.ts's
%% BL-066 note: the extension drives real SwarmForge over tmux, not the
%% "standalone orchestrator" model docs/reference/Specification.MD's overview once
%% described. BL-146 consolidated chase/watchdog liveness into the daemon
%% (handoffd.bb now owns both delivery and chase sweeps). BL-121 added a
%% synthetic canary round-trip: canaryInjector.ts schedules it and
%% handoffd.bb's canary-sweep! completes it as part of the daemon's own poll
%% loop, so transportHealth.ts's health state reflects genuine delivery, not
%% just daemon process liveness. BL-356 added push-sweep! to the same daemon
%% poll loop: it pushes local main to origin on a bounded retry/backoff, and
%% alarms (never force-pushes) on divergence or exhausted retries, so the
%% swarm's own work reaches origin without a human remembering to push.
%% BL-839 added a master-checkout-vs-main drift sweep to the same handoffd.bb
%% cadence (report-only, same alarm channel as the flow watchdog). BL-819
%% added a coordinator-owned ticket lifecycle ledger (.swarmforge/lean/),
%% shelled from the pane at the two points a parcel already changes hands:
%% handoff completion and the close-commit path. BL-855 added a sibling
%% per-commit check to the same push-sweep chokepoint: a merge commit whose
%% tree took none of its second parent's differing content is refused before
%% it reaches origin, however correct its ancestry and message look.
%% BL-1098 added another sibling on the same chokepoint: a path whose tip
%% holds a superseded blob (or is absent with no delete commit) — content no
%% commit authored the change back to — is refused before push, with the
%% reason keyword :silent-revert distinct from BL-855's :noop-landing-merge.
%% BL-820 added the closing-ceremony lean pass: ./finish-shift runs
%% closing-ceremony-run.js before it stops the pipeline, folding the BL-819
%% ledger into a shift packet stored under lean/ceremony/ and delivered to
%% the specifier via a real swarm_handoff.sh note; the coordinator and
%% specifier each record their own adjustment/outcome back against that
%% same run.
%% BL-866 added companionManifest.ts (epic BL-865, Bubble offline-first sync
%% foundation slice): the bridge's companion-manifest + package catalog,
%% read-only, serving versioned JSON packages (backlog, docs) by a
%% content-hash generation so a phone can refresh cheaply.
%% BL-719 added a dropped-parcel chase sweep to the same handoffd.bb cadence
%% as the existing dispatch-gap/open-slot sweeps: a ticket dispatched once
%% then dropped mid-pipeline (BL-714) has a trail but no live mail anywhere,
%% which the dispatch-gap sweep alone can never detect (any trail at all
%% marks it dispatched forever). Report-only, to the coordinator's inbox.
%% BL-891 added a master-main-reconcile sweep to the same handoffd.bb
%% cadence, mirroring BL-356's push-sweep! in the opposite direction:
%% origin/main's landed commits never reached the master checkout's own
%% local main ref (QA can only `git push origin HEAD:main`; git refuses to
%% update a branch checked out in another worktree, and the coordinator is
%% constitutionally forbidden any git merge/push), so every landing left
%% the master checkout further behind and, once it also carried local
%% bookkeeping commits, genuinely diverged. The sweep merges origin/main
%% forward into local main whenever no dirty (or untracked) path overlaps a
%% path the merge would itself change (BL-919 narrowed this from a blanket
%% any-dirt gate); an actual overlap or a merge conflict blocks it and
%% surfaces a note to the coordinator instead
%% of touching the checkout.
%% BL-897 added a lifecycle-snapshot sweep to the same handoffd.bb cadence,
%% immediately ahead of the briefing sections it feeds: ensure-lifecycle-
%% snapshot! runs emit-lifecycle-snapshot.js at most once per UTC day and
%% writes a machine-local .swarmforge/briefing/lifecycle-snapshot.json
%% (gitignored, never committed), which the cost-health sidecar, digest-line
%% and open-ticket-chart briefing CLIs are then all handed via a --snapshot
%% flag so one send's sections read the identical ticket-lifecycle records
%% instead of each re-walking the backlog's full git history. A missing,
%% unreadable or stale snapshot degrades a consumer straight back to its own
%% walk, exactly as it worked before this sweep existed.
%% BL-678 added a batch-claim-progress suspect sweep to the same handoffd.bb
%% cadence: batch-mode claims (cleaner, hardener) now write a
%% .batch-claim-progress.json sidecar the instant ready_for_next_batch.bb
%% claims a parcel (owner role, claim/last-progress instants, last-seen
%% commit) - closing the live-owner half of BL-648's source near-miss (a
%% batch claim with no progress record nearly caused a duplicate
%% re-forward). The sweep refreshes the sidecar from the owning worktree's
%% HEAD and, past a staleness threshold with no advance, surfaces a named
%% suspect note to the coordinator - report-only, same posture as the
%% dropped-parcel sweep; it never re-forwards or re-delivers the parcel
%% itself, and never becomes a liveness oracle for a dead owner (BL-648's
%% job) or touches BL-528's task-mode claim-idle ladder.
%% BL-896 (2026-08-16, heading confirmed 2026-08-17): the open-ticket-chart
%% CLI (module still named render-briefing-burndown.ts) plots open tickets
%% remaining per day next to the architecture diagrams in the briefing
%% email; heading reads "Backlog burndown — open tickets remaining" — the
%% word "burndown" is kept per an explicit 2026-08-16 human ruling that
%% overrides BL-659's PWA/milestone-dashboard ban for this email chart only
%% (see docs/how-to/BL-896-briefing-open-ticket-chart.md).
%% BL-958 (2026-08-20): the tmux server can vanish mid-run while every
%% support daemon stays healthy - the socket file survives on disk and
%% roles.tsv/sessions.tsv still describe a running swarm, so status read
%% per-role DOWN from stale metadata and nobody said the control plane was
%% gone. control_plane_lib.bb is now the one classifier, with three
%% consumers: swarm_status.bb renders ONE control-plane row instead of the
%% stale per-role rows, handoffd.bb's failed chase send persists exactly
%% one open incident to .swarmforge/incidents/control-plane.json, and
%% swarm_ensure.bb decides recovery (relaunch roles from the persisted
%% launch scripts, or halt loudly when none exist) through the same lib.
%% BL-1066 (2026-08-22): swarmMetrics.ts's mean-ticket-time computation was
%% one `git log --follow` per closed ticket (794 on this host, ~102s of git
%% total) driven straight off the panel's 2-second stage-poll tick - a
%% ~102s job on a 2s timer. metricsTickGate.ts is a new, pure, vscode-free
%% module owned by PANEL (one instance, a private field surviving across
%% ticks) that decides whether a tick may recompute: never while a
%% computation for the same subject (target path) is still running, and not
%% again until the standing value has aged past a 5-minute refresh
%% interval; every tick still republishes a complete metrics object, only
%% recomputing on the slower cadence. swarmMetrics.ts itself now walks
%% `git log --full-history -M --name-status -- backlog` ONCE per
%% computation and indexes every ticket's arrival out of that shared index,
%% instead of one walk per file - one git subprocess per computation
%% regardless of corpus size, no change in reported values.
%% BL-1081 (2026-08-23): the vibe spike seat's pane process is
%% acp-host-pane.js (agent CLI as ACP subprocess). The host writes
%% .swarmforge/acp/<role>.json; babysitter_check.bb's gather-role reads it
%% via acp_session_lib.bb. Other seats stay pane-driven.
%% BL-1082 (2026-08-23): operator-facing named-model CLI
%% (extension/out/tools/named-model.js) composes Ollama pull/serve plans;
%% weights live under ~/.swarmforge/models/ollama (outside the tracked
%% worktree) and serve on a loopback OpenAI-compatible endpoint (default
%% http://127.0.0.1:11434). Not a pane spawn path — human-initiated tooling
%% the pack can consume; seat staffing is BL-1052, routing BL-1053.
flowchart TB
  subgraph HOST["Extension Host (Node.js, VS Code Extension API)"]
    EXT["extension.ts\n(command registration)"]
    LAUNCHER["swarmLauncher.ts\n(./swarm wrapper)"]
    TMUXCLIENT["tmuxClient.ts\n(tmux CLI wrapper)"]
    TAILER["paneTailer.ts\n(per-tick pane poll)"]
    DISCOVERY["swarmDiscovery.ts"]
    STATE["swarmState.ts\n(roles.tsv, pipeline stage)"]
    DAEMONHEALTH["daemonHealth.ts\n(handoffd status, read-only)"]
    TRANSPORTHEALTH["transportHealth.ts\n(delivery-level health:\ndead-letters, stalls, canary)"]
    CANARY["canaryInjector.ts\n(schedules synthetic\ncanary round-trips)"]
    METRICS["swarmMetrics.ts"]
    METRICSGATE["metricsTickGate.ts\n(BL-1066: re-entrancy + refresh-interval\ngate, pure/vscode-free, owned by PANEL)"]
    DELIVERYMETRICS["deliveryMetrics.ts\n(velocity/burndown/cycle-time/\nforecasts, git-history-derived)"]
    COSTMETRICS["costTelemetry.ts / resourceTelemetry.ts\n(token cost from transcripts,\nRSS/CPU trends)"]
    HOLISTICUI["holisticProjections.ts / holisticUiHtml.ts\n(self-contained dev-state page,\nserved at bridge root)"]
    BACKLOGRW["backlogReader.ts / backlogWriter.ts"]
    BOUNCE["bounceWatcher.ts / bouncer.ts / bounceDrain.ts"]
    MSGBUS["messageBus.ts\n(append-only audit log)"]
    PRCREATOR["prCreator.ts"]
    BRIDGE["bridgeServer.ts\n(localhost REST+SSE, in-memory token;\nread routes + a small control-scoped\nwrite surface: gate-answer, telegram-inbound,\nreply-ack)"]
    COMPANIONMANIFEST["companionManifest.ts\n(BL-866: companion-manifest +\npackage catalog, versioned JSON\nby content-hash generation)"]
    PANEL["swarmPanel.ts / workTreePanel.ts\n(webview controller)"]
    NAMEDMODEL["named-model.js + modelServing.ts\n(BL-1082: compose/execute Ollama\npull|serve|status; operator CLI)"]
  end

  subgraph WEBVIEW["Webview (browser context, presentation only)"]
    TILES["Tile grid UI\n(panel.js + webviewHtml.ts template)"]
  end

  subgraph SUBSTRATE["tmux Substrate"]
    SOCKET[".swarmforge/tmux-socket"]
    PANES["One tmux pane per pipeline role\n(coordinator, specifier, coder, cleaner,\narchitect, hardender, documenter, QA)"]
  end

  subgraph SWARMSTATE[".swarmforge/ State (files, shared;\nlives in the MASTER checkout - linked\nworktrees carry none, BL-966)"]
    ROLESTSV["roles.tsv, sessions.tsv"]
    HANDOFFS["handoffs/{inbox,outbox,sent,failed}/"]
    DAEMONDIR["daemon/ (handoffd pid, heartbeat, log)"]
    QABOUNCES["qa_bounces/ (BL-454: legacy QA-only bounce records,\n*.jsonl, read-only since BL-635)"]
    BOUNCES["bounces/ (BL-635: go-forward bounce records\nby any reviewing role, *.jsonl)"]
    QADEFER["qa_deferrals/ (BL-532: deferral records, *.jsonl)"]
    LEANDIR["lean/ (BL-819: coordinator-owned ticket\nlifecycle ledger, *.jsonl + per-ticket snapshot)"]
    CEREMONYDIR["lean/ceremony/ (BL-820: closing-ceremony\nrun records, one JSON per shift)"]
    INCIDENTDIR["incidents/control-plane.json (BL-958: control-plane-loss\nincidents, at most one open at a time)"]
    IDENTITY["swarm-identity (BL-313: the conf this launch\nactually loaded; BL-966: read at the master checkout\nfrom any worktree via git rev-parse --git-common-dir)"]
    ACPDIR["acp/<role>.json (BL-1081: structured seat\nsnapshot — stop reason, idle, permission;\nvibe spike seat only today)"]
    BACKLOGDIR["../backlog/{root,paused,active,done}/"]
  end

  subgraph LOCALINFER["Local inference (BL-1082, host-side)"]
    MODELSTORE["~/.swarmforge/models/ollama\n(OLLAMA_MODELS; outside worktree)"]
    OLLAMA["ollama pull / ollama serve\n(loopback OpenAI-compatible API)"]
  end

  subgraph GITHUB["git / GitHub"]
    TARGETREPO["target repo: dev branch + main"]
    GH["GitHub PR via git + gh CLI"]
  end

