+  (let [n (count samples-ms)]
+    (when (>= n min-samples-for-calibration)
+      (let [warn-raw (or (percentile-ms samples-ms warn-percentile) 0)
+            esc-raw (or (percentile-ms samples-ms escalate-percentile) 0)
+            warn-ms (max min-warn-ms (long warn-raw))
+            escalate-ms (max (inc warn-ms) (long esc-raw))]
+        {:warn-ms warn-ms :escalate-ms escalate-ms :n n}))))
