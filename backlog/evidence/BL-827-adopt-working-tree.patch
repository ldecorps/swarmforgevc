+(defn spec-key
+  "Exact lookup key: \"from->to|type\". Blank parts become \"?\" so a missing
+   header never collides with a real role/type name."
+  [{:keys [from to type]}]
+  (str (or (not-empty from) "?") "->" (or (not-empty to) "?") "|" (or (not-empty type) "?")))
