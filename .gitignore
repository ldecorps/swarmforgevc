.DS_Store
.env
.claude/
.swarmforge/
# BL-1829: a local-model seat's own project-level qwen settings (written
# by write_local_model_qwen_settings) - runtime launch state, per-seat,
# never a role's own commit.
.qwen/
# Python bytecode - untracked __pycache__/ was blocking every post-land
# QA-branch re-point (LAND_REPOINT_SKIPPED an uncommitted change) and
# letting origin/main..swarmforge-QA grow without bound (4020 commits by
# 2026-09-29). git status --porcelain ignores these once listed here.
__pycache__/
*.py[cod]

# BL-593: append-only machine-local mutation run telemetry (same posture as context-events.jsonl).
.swarmforge/telemetry/mutation-runs.jsonl
# BL-596: mono-router rotation dynamics append-only telemetry.
.swarmforge/telemetry/rotation-*.jsonl
# BL-597: append-only self-heal telemetry for behaviour trends.
.swarmforge/telemetry/self-heal-*.jsonl
swarmforge/scripts/.bin/
.worktrees/
/tmp/
extension/tmp/
/node_modules/
extension/node_modules/
extension/out/
extension/coverage/
extension/.stryker-tmp/
extension/reports/
extension/.dev-activation.json
extension/.test-durations.jsonl
extension/.vitest-report.json
extension/.property-durations.jsonl
extension/.property-vitest-report.json
swarmforge/scripts/test/.property-runner-durations.jsonl
*.code-workspace
extension/stryker-incremental.json
extension/stryker-incremental-live.json
.aider*
specs/pipeline/generated/
/calls.log
/email-text.txt
/failure.log
/status.json
# BL-875: root-anchored - the repo root has no package.json, so an
# accidental `npm install` there recreates this file; anchored (not a
# bare `package-lock.json` line) so extension/package-lock.json, a real
# tracked deployed surface, stays tracked.
/package-lock.json

# Hotfix 2026-10-03: a Python virtualenv never belongs in the repo. The
# qwen2.5 coder seat created venv/ in its worktree and committed 1,019 of
# its files (10aaa15e97) on git's "use git add to track" hint (QA D4).
venv/
.venv/
